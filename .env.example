# Create these variables in Vercel and in your local .env file.
# The publishable key is intended for browser use; Row Level Security protects table access.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Compatibility only: the app also accepts VITE_SUPABASE_ANON_KEY for older projects.
# Never put a service_role key or a Supabase secret key in a VITE_* variable.
